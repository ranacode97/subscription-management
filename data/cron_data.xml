<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Check Expiring Subscriptions - Daily -->
    <record id="cron_check_expiring_subscriptions" model="ir.cron">
        <field name="name">Subscription: Check Expiring</field>
        <field name="model_id" ref="model_subscription_subscription"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_expiring_subscriptions()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>

    <!-- Auto-Renew Subscriptions - Daily -->
    <record id="cron_auto_renew_subscriptions" model="ir.cron">
        <field name="name">Subscription: Auto Renew</field>
        <field name="model_id" ref="model_subscription_subscription"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_renew_subscriptions()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>

</odoo>
