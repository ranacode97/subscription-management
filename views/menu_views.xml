<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ════════════════ TOP MENU ════════════════ -->
    <menuitem id="menu_subscription_root"
              name="Subscriptions"
              web_icon="subscription_management,static/description/icon.png"
              sequence="25"/>

    <!-- ════════════════ FIRST LEVEL MENUS ════════════════ -->
    <menuitem id="menu_subscription_main"
              name="Subscriptions"
              parent="menu_subscription_root"
              sequence="10"/>

    <menuitem id="menu_subscription_config"
              name="Configuration"
              parent="menu_subscription_root"
              sequence="90"/>

    <!-- ════════════════ SECOND LEVEL MENUS ════════════════ -->
    <menuitem id="menu_subscription_all"
              name="All Subscriptions"
              parent="menu_subscription_main"
              action="action_subscription"
              sequence="10"/>

    <menuitem id="menu_subscription_domains"
              name="Domains"
              parent="menu_subscription_main"
              action="action_subscription_domain"
              sequence="20"/>

    <menuitem id="menu_subscription_plans"
              name="Plans"
              parent="menu_subscription_config"
              action="action_subscription_plan"
              sequence="10"/>
</odoo>
