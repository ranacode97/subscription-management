<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════ DOMAIN TREE VIEW ════════════════ -->
    <record id="view_subscription_domain_tree" model="ir.ui.view">
        <field name="name">subscription.domain.tree</field>
        <field name="model">subscription.domain</field>
        <field name="arch" type="xml">
            <tree string="Domains"
                  decoration-success="state == 'active'"
                  decoration-warning="state == 'propagating'"
                  decoration-danger="state == 'error'"
                  decoration-muted="state == 'inactive'">
                <field name="name"/>
                <field name="subscription_id"/>
                <field name="partner_id"/>
                <field name="is_primary"/>
                <field name="state" widget="badge"/>
                <field name="dns_provider"/>
                <field name="ssl_enabled"/>
                <field name="ssl_expiry_date"/>
                <field name="expiry_date"/>
            </tree>
        </field>
    </record>

    <!-- ════════════════ DOMAIN FORM VIEW ════════════════ -->
    <record id="view_subscription_domain_form" model="ir.ui.view">
        <field name="name">subscription.domain.form</field>
        <field name="model">subscription.domain</field>
        <field name="arch" type="xml">
            <form string="Domain">
                <header>
                    <button name="action_activate" string="Activate" type="object"
                            class="oe_highlight" invisible="state == 'active'"/>
                    <button name="action_set_propagating" string="Set Propagating" type="object"
                            invisible="state != 'pending'"/>
                    <button name="action_deactivate" string="Deactivate" type="object"
                            invisible="state != 'active'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,propagating,active"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="example.com"/></h1>
                    </div>
                    <group>
                        <group string="Subscription">
                            <field name="subscription_id"/>
                            <field name="partner_id"/>
                            <field name="is_primary"/>
                        </group>
                        <group string="Registration">
                            <field name="registrar"/>
                            <field name="registration_date"/>
                            <field name="expiry_date"/>
                        </group>
                    </group>
                    <group>
                        <group string="DNS Configuration">
                            <field name="dns_provider"/>
                            <field name="ip_address"/>
                            <field name="nameserver_1"/>
                            <field name="nameserver_2"/>
                        </group>
                        <group string="SSL Certificate">
                            <field name="ssl_enabled"/>
                            <field name="ssl_issuer" invisible="not ssl_enabled"/>
                            <field name="ssl_expiry_date" invisible="not ssl_enabled"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ════════════════ DOMAIN SEARCH VIEW ════════════════ -->
    <record id="view_subscription_domain_search" model="ir.ui.view">
        <field name="name">subscription.domain.search</field>
        <field name="model">subscription.domain</field>
        <field name="arch" type="xml">
            <search string="Search Domains">
                <field name="name"/>
                <field name="subscription_id"/>
                <field name="partner_id"/>
                <filter string="Active" name="filter_active" domain="[('state', '=', 'active')]"/>
                <filter string="SSL Enabled" name="filter_ssl" domain="[('ssl_enabled', '=', True)]"/>
                <filter string="Primary" name="filter_primary" domain="[('is_primary', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="DNS Provider" name="group_dns" context="{'group_by': 'dns_provider'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ════════════════ DOMAIN ACTION ════════════════ -->
    <record id="action_subscription_domain" model="ir.actions.act_window">
        <field name="name">Domains</field>
        <field name="res_model">subscription.domain</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_subscription_domain_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No domains registered yet.
            </p>
        </field>
    </record>

</odoo>
