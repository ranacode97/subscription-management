<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════ PLAN TREE VIEW ════════════════ -->
    <record id="view_subscription_plan_tree" model="ir.ui.view">
        <field name="name">subscription.plan.tree</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml">
            <tree string="Subscription Plans">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="billing_cycle"/>
                <field name="duration_months"/>
                <field name="price" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="max_domains"/>
                <field name="max_storage_gb"/>
                <field name="feature_ssl"/>
                <field name="feature_backup"/>
                <field name="subscription_count"/>
            </tree>
        </field>
    </record>

    <!-- ════════════════ PLAN FORM VIEW ════════════════ -->
    <record id="view_subscription_plan_form" model="ir.ui.view">
        <field name="name">subscription.plan.form</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml">
            <form string="Subscription Plan">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_subscriptions" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="subscription_count" widget="statinfo" string="Subscriptions"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Plan Name"/></h1>
                        <label for="code"/>
                        <h3><field name="code" placeholder="PLAN-CODE"/></h3>
                    </div>
                    <group>
                        <group string="Billing">
                            <field name="billing_cycle"/>
                            <field name="duration_months"/>
                            <field name="price" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group string="Limits">
                            <field name="max_domains"/>
                            <field name="max_storage_gb"/>
                            <field name="max_users"/>
                            <field name="max_bandwidth_gb"/>
                        </group>
                    </group>
                    <group string="Features">
                        <group>
                            <field name="feature_ssl"/>
                            <field name="feature_backup"/>
                        </group>
                        <group>
                            <field name="feature_support"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Plan description..."/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ════════════════ PLAN ACTION ════════════════ -->
    <record id="action_subscription_plan" model="ir.actions.act_window">
        <field name="name">Subscription Plans</field>
        <field name="res_model">subscription.plan</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first subscription plan!
            </p>
        </field>
    </record>

</odoo>
