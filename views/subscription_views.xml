<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════ SUBSCRIPTION TREE VIEW ════════════════ -->
    <record id="view_subscription_tree" model="ir.ui.view">
        <field name="name">subscription.subscription.tree</field>
        <field name="model">subscription.subscription</field>
        <field name="arch" type="xml">
            <tree string="Subscriptions" decoration-danger="state=='expired'"
                  decoration-warning="state=='expiring_soon'"
                  decoration-muted="state=='cancelled'"
                  decoration-success="state=='active'">
                <field name="reference"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="days_to_expire"/>
                <field name="recurring_price" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="domain_count"/>
                <field name="is_auto_renew"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'expiring_soon'"
                       decoration-danger="state == 'expired'"
                       decoration-info="state in ('draft','confirm')"/>
            </tree>
        </field>
    </record>

    <!-- ════════════════ SUBSCRIPTION FORM VIEW ════════════════ -->
    <record id="view_subscription_form" model="ir.ui.view">
        <field name="name">subscription.subscription.form</field>
        <field name="model">subscription.subscription</field>
        <field name="arch" type="xml">
            <form string="Subscription">
                <header>
                    <button name="action_confirm" string="Confirm"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_activate" string="Activate"
                            type="object" class="oe_highlight"
                            invisible="state not in ('confirm', 'expired')"/>
                    <button name="action_renew" string="🔄 Renew"
                            type="object" class="oe_highlight"
                            invisible="state not in ('active', 'expiring_soon', 'expired')"/>
                    <button name="action_cancel" string="Cancel"
                            type="object"
                            invisible="state in ('cancelled', 'draft')"
                            confirm="Are you sure you want to cancel this subscription?"/>
                    <button name="action_set_to_draft" string="Set to Draft"
                            type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirm,active,expired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_domains" type="object"
                                class="oe_stat_button" icon="fa-globe">
                            <field name="domain_count" widget="statinfo" string="Domains"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="reference"/>
                        <h1><field name="reference" readonly="1"/></h1>
                        <label for="name"/>
                        <h2><field name="name" placeholder="Subscription Name"/></h2>
                    </div>
                    <group>
                        <group string="Subscription Details">
                            <field name="partner_id"/>
                            <field name="plan_id"/>
                            <field name="recurring_price" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Dates &amp; Renewal">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="days_to_expire"/>
                            <field name="date_next_invoice"/>
                            <field name="is_auto_renew"/>
                            <field name="renewal_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Domains" name="domains">
                            <field name="domain_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="is_primary"/>
                                    <field name="state" widget="badge"/>
                                    <field name="dns_provider"/>
                                    <field name="ip_address"/>
                                    <field name="ssl_enabled"/>
                                    <field name="ssl_expiry_date"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Tags &amp; Notes" name="notes">
                            <group>
                                <field name="tag_ids" widget="many2many_tags"
                                       options="{'color_field': 'color'}"/>
                            </group>
                            <field name="notes" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ════════════════ SUBSCRIPTION KANBAN VIEW ════════════════ -->
    <record id="view_subscription_kanban" model="ir.ui.view">
        <field name="name">subscription.subscription.kanban</field>
        <field name="model">subscription.subscription</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="date_end"/>
                <field name="days_to_expire"/>
                <field name="state"/>
                <field name="recurring_price"/>
                <field name="currency_id"/>
                <field name="color"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click"
                             t-att-style="'border-left: 4px solid ' + (record.state.raw_value == 'active' ? '#28a745' : record.state.raw_value == 'expiring_soon' ? '#ffc107' : record.state.raw_value == 'expired' ? '#dc3545' : '#6c757d')">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top mb-0">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="reference"/> - <field name="name"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div><strong>Customer:</strong> <field name="partner_id"/></div>
                                    <div><strong>Plan:</strong> <field name="plan_id"/></div>
                                    <div><strong>Expires:</strong> <field name="date_end"/>
                                        (<field name="days_to_expire"/> days)
                                    </div>
                                    <div>
                                        <strong>Price:</strong>
                                        <field name="recurring_price" widget="monetary"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="activity_ids" widget="kanban_activity"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ════════════════ SUBSCRIPTION SEARCH VIEW ════════════════ -->
    <record id="view_subscription_search" model="ir.ui.view">
        <field name="name">subscription.subscription.search</field>
        <field name="model">subscription.subscription</field>
        <field name="arch" type="xml">
            <search string="Search Subscriptions">
                <field name="reference"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <filter string="Active" name="filter_active"
                        domain="[('state', '=', 'active')]"/>
                <filter string="Expiring Soon" name="filter_expiring"
                        domain="[('state', '=', 'expiring_soon')]"/>
                <filter string="Expired" name="filter_expired"
                        domain="[('state', '=', 'expired')]"/>
                <separator/>
                <filter string="Auto Renew" name="filter_auto_renew"
                        domain="[('is_auto_renew', '=', True)]"/>
                <separator/>
                <filter string="Expiring in 7 Days" name="filter_7days"
                        domain="[('days_to_expire', '&lt;=', 7), ('days_to_expire', '&gt;', 0)]"/>
                <filter string="Expiring in 30 Days" name="filter_30days"
                        domain="[('days_to_expire', '&lt;=', 30), ('days_to_expire', '&gt;', 0)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Plan" name="group_plan" context="{'group_by': 'plan_id'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Salesperson" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Start Date" name="group_start" context="{'group_by': 'date_start:month'}"/>
                    <filter string="Expiry Date" name="group_end" context="{'group_by': 'date_end:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ════════════════ SUBSCRIPTION ACTION ════════════════ -->
    <record id="action_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">subscription.subscription</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_subscription_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first subscription!
            </p>
            <p>
                Manage customer subscriptions with plans, domains, and automated renewals.
            </p>
        </field>
    </record>

</odoo>
