<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_renew_wizard_form" model="ir.ui.view">
        <field name="name">subscription.renew.wizard.form</field>
        <field name="model">subscription.renew.wizard</field>
        <field name="arch" type="xml">
            <form string="Renew Subscription">
                <group>
                    <field name="subscription_id"/>
                    <field name="plan_id"/>
                    <field name="new_start_date"/>
                    <field name="new_end_date"/>
                </group>
                <footer>
                    <button name="action_renew" string="Renew" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
