<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_subscription_report_pivot" model="ir.ui.view">
        <field name="name">subscription.subscription.pivot</field>
        <field name="model">subscription.subscription</field>
        <field name="arch" type="xml">
            <pivot string="Subscription Analysis">
                <field name="plan_id" type="row"/>
                <field name="state" type="col"/>
                <field name="recurring_price" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_subscription_report_graph" model="ir.ui.view">
        <field name="name">subscription.subscription.graph</field>
        <field name="model">subscription.subscription</field>
        <field name="arch" type="xml">
            <graph string="Subscription Analysis" type="bar">
                <field name="plan_id"/>
                <field name="recurring_price" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_subscription_report" model="ir.actions.act_window">
        <field name="name">Subscription Analysis</field>
        <field name="res_model">subscription.subscription</field>
        <field name="view_mode">pivot,graph</field>
    </record>

    <menuitem id="menu_subscription_report"
              name="Reporting"
              parent="menu_subscription_root"
              sequence="80"/>

    <menuitem id="menu_subscription_analysis"
              name="Subscription Analysis"
              parent="menu_subscription_report"
              action="action_subscription_report"
              sequence="10"/>

</odoo>
